# URL ou chave de API do provedor LLM utilizado pelo agente
# Exemplo: sk-... (OpenAI) ou equivalente
OPENAI_API_KEY=

# Base URL da API (para provedores compatíveis com OpenAI, ex: xAI, Azure)
# Padrão: https://api.openai.com/v1 (se não definido, usa OpenAI)
OPENAI_BASE_URL=

# Modelo LLM a ser utilizado na análise de documentação
# Exemplo: gpt-4o-mini, grok-3
LLM_MODEL=

# Diretório temporário para clonagem de repositórios
# Padrão: /tmp/doc-intelligence-agent
TEMP_CLONE_DIR=

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Token GitHub para API (opcional, aumenta rate limit de 60 para 5000 req/h)
# Gerar em: https://github.com/settings/tokens
GITHUB_TOKEN=
