# URL ou chave de API do provedor LLM utilizado pelo agente
# Exemplo: sk-... (OpenAI) ou equivalente
# OPENAI_API_KEY=

# Modelo LLM a ser utilizado na análise de documentação
# Exemplo: gpt-4o-mini
LLM_MODEL=

# Diretório temporário para clonagem de repositórios
# Padrão: /tmp/doc-intelligence-agent
TEMP_CLONE_DIR=

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
