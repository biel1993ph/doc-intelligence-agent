{
  "name": "Doc Intelligence Agent - Análise de Documentação",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "analyze-docs",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "analyze-docs-trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"url\": $json.body.url }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "http-request",
      "name": "Chamar API de Análise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-score",
              "leftValue": "={{ $json.score }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-success",
      "name": "Análise com sucesso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "webhookUrl": "={{$env.DISCORD_WEBHOOK_URL}}",
        "text": "=📊 **Análise de Documentação Concluída**\n\n📁 Repositório: {{ $('Webhook Trigger').item.json.body.url }}\n⭐ Nota: **{{ $json.score }}/10**\n📋 Pontos fortes: {{ $json.strengths_count }}\n⚠️ Problemas: {{ $json.issues_count }}\n🔗 Trace ID: {{ $json.trace_id }}\n\n---\n_Análise realizada pelo Doc Intelligence Agent_",
        "options": {}
      },
      "id": "discord-notify",
      "name": "Notificar Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [960, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ \"status\": \"notified\", \"score\": $json.score, \"trace_id\": $json.trace_id }) }}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Responder Sucesso",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ \"status\": \"error\", \"errors\": $json.errors }) }}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "respond-error",
      "name": "Responder Erro",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 500]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{"node": "Chamar API de Análise", "type": "main", "index": 0}]
      ]
    },
    "Chamar API de Análise": {
      "main": [
        [{"node": "Análise com sucesso?", "type": "main", "index": 0}]
      ]
    },
    "Análise com sucesso?": {
      "main": [
        [
          {"node": "Notificar Discord", "type": "main", "index": 0},
          {"node": "Responder Sucesso", "type": "main", "index": 0}
        ],
        [
          {"node": "Responder Erro", "type": "main", "index": 0}
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Fluxo n8n para integração com Doc Intelligence Agent. Recebe URL via webhook, chama API de análise, notifica Discord com resultado.",
    "templateCredsSetupCompleted": true
  }
}
